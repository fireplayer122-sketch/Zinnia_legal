# Flask
FLASK_SECRET_KEY=replace-this-with-a-long-random-secret
PORT=5000

# Live Zinnia data. Point these at the bot's real files on the host.
ZINNIA_DATABASE=C:/path/to/Discord bot/database.db
ZINNIA_CARDS_DIR=C:/path/to/Discord bot/cards

# Discord OAuth (Public Client + PKCE)
DISCORD_CLIENT_ID=
DISCORD_REDIRECT_URI=

# Bot invite
DISCORD_INVITE_URL=
